# Local research-only setup. Generate a unique secret before starting.
VORTEX_SECRET_KEY=
VORTEX_HOST=127.0.0.1
VORTEX_PORT=8000
# live: fail explicitly on unavailable market data; demo: synthetic data.
VORTEX_DATA_MODE=live
# Optional notifications. Never commit real values.
VORTEX_TELEGRAM_TOKEN=
VORTEX_TELEGRAM_CHAT_ID=
VORTEX_PUBLIC_URL=
# Public market data does not require an exchange API key.
# Real order submission is blocked by run_smc.py.
VORTEX_BINANCE_KEY=
VORTEX_BINANCE_SECRET=
VORTEX_BINANCE_TESTNET=true
VORTEX_COINGECKO_KEY=
VORTEX_PUSH_CONTACT=vortex@localhost
